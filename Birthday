<!DOCTYPE html><html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Happy Birthday 🎉</title>
  <style>
    body {
      margin: 0;
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #ff9a9e, #fad0c4);
      color: #333;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      overflow: hidden;
    }.card {
  background: white;
  border-radius: 20px;
  padding: 30px 25px;
  width: 90%;
  max-width: 400px;
  text-align: center;
  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.2);
  animation: pop 1s ease;
}

@keyframes pop {
  0% { transform: scale(0.8); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

h1 {
  color: #ff4081;
  margin-bottom: 10px;
  font-size: 2.2rem;
}

h2 {
  font-weight: 500;
  margin-bottom: 15px;
}

p {
  font-size: 1rem;
  line-height: 1.6;
  margin-bottom: 20px;
}

button {
  background: #ff4081;
  color: white;
  border: none;
  padding: 12px 25px;
  font-size: 1rem;
  border-radius: 25px;
  cursor: pointer;
  transition: 0.3s;
}

button:hover {
  background: #e73370;
  transform: scale(1.05);
}

.surprise {
  display: none;
  margin-top: 20px;
  font-size: 1.1rem;
  color: #444;
}

.balloon {
  position: absolute;
  bottom: -150px;
  width: 40px;
  height: 55px;
  background: #ff4081;
  border-radius: 50% 50% 50% 50%;
  animation: float 6s linear infinite;
  opacity: 0.8;
}

.balloon::after {
  content: '';
  position: absolute;
  width: 2px;
  height: 40px;
  background: #555;
  top: 55px;
  left: 50%;
}

@keyframes float {
  0% { transform: translateY(0); }
  100% { transform: translateY(-110vh); }
}

  </style>
</head>
<body>  <div class="card">
    <h1>🎂 Happy Birthday 🎂</h1>
    <h2>Dear Friend 💖</h2>
    <p>
      May your day be filled with smiles, laughter,
      love, and everything that makes you happy.
    </p>
    <button onclick="showSurprise()">Click for Surprise 🎁</button>
    <div class="surprise" id="surprise">
      ✨ You are special, loved, and amazing ✨<br />
      Have a wonderful year ahead! 🥳
    </div>
  </div>  <script>
    function showSurprise() {
      document.getElementById('surprise').style.display = 'block';
    }

    // Create floating balloons
    for (let i = 0; i < 15; i++) {
      const balloon = document.createElement('div');
      balloon.className = 'balloon';
      balloon.style.left = Math.random() * 100 + 'vw';
      balloon.style.animationDuration = (4 + Math.random() * 4) + 's';
      balloon.style.background = `hsl(${Math.random() * 360}, 80%, 60%)`;
      document.body.appendChild(balloon);
    }
  </script></body>
</html>
